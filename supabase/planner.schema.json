          "title",
          "memberId",
          "period",
          "days",
          "steps"
        ],
        "additionalProperties": false
      }
    },
    "routineChecks": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "routineId": {
            "type": "string",
            "minLength": 1,
