      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "memberId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "cost": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        },
        "required": [
