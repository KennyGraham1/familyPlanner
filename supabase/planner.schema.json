{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "settings": {
      "type": "object",
      "properties": {
        "familyName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "currentMemberId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "weekStartsMonday": {
          "type": "boolean"
        },
        "timezone": {
          "type": "string",
          "maxLength": 100
        },
        "digestDay": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "digestTime": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "quietStart": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "quietEnd": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "changeAlerts": {
          "type": "boolean"
        },
        "monthlyBudget": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        }
      },
      "required": [
        "familyName",
        "currentMemberId",
        "weekStartsMonday"
      ],
      "additionalProperties": false
    },
    "members": {
      "minItems": 1,
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "role": {
            "type": "string",
            "maxLength": 50
          },
          "color": {
            "type": "string",
            "enum": [
              "lavender",
              "sage",
              "peach",
              "blue",
              "rose",
              "yellow"
            ]
          },
          "emoji": {
            "type": "string",
            "maxLength": 10
          }
        },
        "required": [
          "id",
          "name",
          "role",
          "color",
          "emoji"
        ],
        "additionalProperties": false
      }
    },
    "events": {
      "maxItems": 5000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "start": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "end": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "memberIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "location": {
            "type": "string",
            "maxLength": 200
          },
          "notes": {
            "type": "string",
            "maxLength": 2000
          },
          "repeat": {
            "type": "string",
            "enum": [
              "none",
              "weekly",
              "fortnightly",
              "monthly",
              "yearly"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "Activity",
              "School",
              "Appointment",
              "Family time",
              "Work"
            ]
          },
          "endDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "until": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "allDay": {
            "type": "boolean"
          },
          "dropOffMemberId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "pickupMemberId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "origin": {
            "type": "object",
            "properties": {
              "eventId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "day": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            },
            "required": [
              "eventId",
              "day"
            ],
            "additionalProperties": false
          },
          "checklist": {
            "maxItems": 40,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 150
                }
              },
              "required": [
                "id",
                "title"
              ],
              "additionalProperties": false
            }
          },
          "checklistDone": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "maxItems": 40,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            }
          },
          "excludedDates": {
            "maxItems": 366,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          "excludedRanges": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "end": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                }
              },
              "required": [
                "start",
                "end"
              ],
              "additionalProperties": false
            }
          },
          "place": {
            "type": "object",
            "properties": {
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "lon": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            },
            "required": [
              "lat",
              "lon"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "title",
          "date",
          "start",
          "end",
          "memberIds",
          "location",
          "notes",
          "repeat",
          "category"
        ],
        "additionalProperties": false
      }
    },
    "tasks": {
      "maxItems": 5000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "memberId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "due": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "done": {
            "type": "boolean"
          },
          "priority": {
            "type": "string",
            "enum": [
              "normal",
              "high"
            ]
          },
          "repeat": {
            "type": "string",
            "enum": [
              "daily",
              "weekly",
              "fortnightly",
              "monthly"
            ]
          },
          "rotation": {
            "minItems": 2,
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "series": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "doneAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "id",
          "title",
          "memberId",
          "due",
          "done",
          "priority"
        ],
        "additionalProperties": false
      }
    },
    "shopping": {
      "maxItems": 5000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "quantity": {
            "type": "string",
            "maxLength": 500
          },
          "category": {
            "type": "string",
            "enum": [
              "Produce",
              "Dairy & eggs",
              "Meat & fish",
              "Bakery",
              "Pantry",
              "Household",
              "Other"
            ]
          },
          "done": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "quantity",
          "category",
          "done"
        ],
        "additionalProperties": false
      }
    },
    "meals": {
      "maxItems": 5000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "slot": {
            "type": "string",
            "enum": [
              "Breakfast",
              "Lunch",
              "Dinner"
            ]
          },
          "recipeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "servings": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "id",
          "date",
          "slot"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "maxItems": 5000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "memberId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "color": {
            "type": "string",
            "enum": [
              "lavender",
              "sage",
              "peach",
              "blue",
              "rose",
              "yellow"
            ]
          },
          "pinned": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "id",
          "title",
          "body",
          "memberId",
          "color",
          "pinned",
          "createdAt"
        ],
        "additionalProperties": false
      }
    },
    "recipePrefs": {
      "maxItems": 5000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "memberId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "recipeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "favourite": {
            "type": "boolean"
          },
          "cookSoon": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "memberId",
          "recipeId",
          "favourite",
          "cookSoon"
        ],
        "additionalProperties": false
      }
    },
    "customRecipes": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "subtitle": {
            "type": "string",
            "maxLength": 300
          },
          "time": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1440
          },
          "servings": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "image": {
            "type": "string",
            "maxLength": 2000
          },
          "color": {
            "type": "string",
            "enum": [
              "lavender",
              "sage",
              "peach",
              "blue",
              "rose",
              "yellow"
            ]
          },
          "cuisine": {
            "type": "string",
            "maxLength": 100
          },
          "region": {
            "type": "string",
            "enum": [
              "West Africa",
              "Everyday"
            ]
          },
          "diet": {
            "type": "string",
            "enum": [
              "Plant-based",
              "Vegetarian",
              "Meat & fish"
            ]
          },
          "lighter": {
            "type": "boolean"
          },
          "prepTime": {
            "type": "number"
          },
          "cookTime": {
            "type": "number"
          },
          "restTime": {
            "type": "number"
          },
          "restLabel": {
            "type": "string"
          },
          "servingSuggestion": {
            "type": "string",
            "maxLength": 1000
          },
          "tips": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "source": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 150
              },
              "url": {
                "type": "string",
                "maxLength": 2000,
                "format": "uri"
              }
            },
            "required": [
              "name",
              "url"
            ],
            "additionalProperties": false
          },
          "ingredients": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 150
                },
                "quantity": {
                  "type": "string",
                  "maxLength": 50
                },
                "category": {
                  "type": "string",
                  "enum": [
                    "Produce",
                    "Dairy & eggs",
                    "Meat & fish",
                    "Bakery",
                    "Pantry",
                    "Household",
                    "Other"
                  ]
                }
              },
              "required": [
                "name",
                "quantity",
                "category"
              ],
              "additionalProperties": false
            }
          },
          "steps": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          }
        },
        "required": [
          "id",
          "name",
          "subtitle",
          "time",
          "servings",
          "category",
          "image",
          "color",
          "ingredients",
          "steps"
        ],
        "additionalProperties": false
      }
    },
    "mealTemplates": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "entries": {
            "minItems": 1,
            "maxItems": 21,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "weekday": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6
                },
                "slot": {
                  "type": "string",
                  "enum": [
                    "Breakfast",
                    "Lunch",
                    "Dinner"
                  ]
                },
                "recipeId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "note": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 150
                },
                "servings": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 50
                }
              },
              "required": [
                "weekday",
                "slot"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "entries"
        ],
        "additionalProperties": false
      }
    },
    "pantry": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "quantity": {
            "type": "string",
            "maxLength": 50
          },
          "category": {
            "type": "string",
            "enum": [
              "Produce",
              "Dairy & eggs",
              "Meat & fish",
              "Bakery",
              "Pantry",
              "Household",
              "Other"
            ]
          },
          "useBy": {
            "type": "string",
