          }
        },
        "required": [
          "id",
          "name",
          "quantity",
          "category"
        ],
        "additionalProperties": false
      }
    },
    "routines": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "minLength": 1,
