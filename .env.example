# Optional: enable accounts and shared family spaces. See README.md.
NEXT_PUBLIC_SUPABASE_URL=
# Preferred public key name (the older ANON_KEY name also works).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server-only settings for scheduled phone reminders.
# Use the secret key from the SAME Supabase project as the public URL.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY is also supported for existing integrations.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
CRON_SECRET=

# Optional two-way Google Calendar sync. See docs/google-calendar-setup.md.
# Server-only: never prefix these names with NEXT_PUBLIC_.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://kinfolk-graham.vercel.app/api/google-calendar/callback
# A stable random 32-byte key encoded as base64. Keep it when redeploying.
GOOGLE_CALENDAR_ENCRYPTION_KEY=
